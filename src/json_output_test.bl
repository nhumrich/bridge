test "cmd_project_show json keeps comma-bearing tags as one element in project and nested tasks" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO projects (id, name) VALUES ('PROJ0001', 'launch')").unwrap()
        db.exec("INSERT INTO project_tags (project_id, tag) VALUES ('PROJ0001', 'x,y')").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority, project_id) VALUES ('TASK0001', 'T', 'open', 2, 'PROJ0001')").unwrap()
        db.exec("INSERT INTO tags (task_id, tag) VALUES ('TASK0001', 'a,b')").unwrap()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_project_show("launch", true)
        }
        json_clear()
        let obj = json_parse(output.get(0) ?? "\{\}")
        let project_tags_node = json_get(obj, "tags")
        assert_eq(json_type(project_tags_node), JSON_ARRAY)
        assert_eq(json_len(project_tags_node), 1)
        assert_eq(json_as_str(json_at(project_tags_node, 0)), "x,y")

        let tasks_node = json_get(obj, "tasks")
        assert_eq(json_len(tasks_node), 1)
        let task_tags_node = json_get(json_at(tasks_node, 0), "tags")
        assert_eq(json_type(task_tags_node), JSON_ARRAY)
        assert_eq(json_len(task_tags_node), 1)
        assert_eq(json_as_str(json_at(task_tags_node, 0)), "a,b")
    }
}

// Regression test for 564jmt: br edit --desc with a payload larger than
// SQLite's inlined-literal comfort zone (~4000 bytes) used to panic at the
// unwrap() because db.exec failed on the oversized interpolated statement.
// Fixed in 14615c1 by binding description as a Template[DB] parameter.
test "cmd_edit with a description over 4000 bytes does not panic" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASK0001', 'T', 'open', 2)").unwrap()
        let big_desc = long_string(5000)
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_edit("TASK0001", "", big_desc, -1, "", "", false, false)
        }
        let row = db.query_one("SELECT description FROM tasks WHERE id = 'TASK0001'").unwrap().unwrap()
        assert_eq((row.get_at(0) ?? "").len(), 5000)
    }
}
