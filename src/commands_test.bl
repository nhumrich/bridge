test "cmd_project_rm unlinks member tasks" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO projects (id, name) VALUES ('PROJ0001', 'launch')").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority, project_id) VALUES ('TASK0001', 'Member', 'open', 2, 'PROJ0001')").unwrap()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_project_rm("launch")
        }
        let proj_rows = db.query("SELECT id FROM projects").unwrap()
        assert_eq(proj_rows.len(), 0)
        let task_rows = db.query("SELECT id FROM tasks WHERE id = 'TASK0001'").unwrap()
        assert_eq(task_rows.len(), 1)
        let row = db.query_one("SELECT project_id FROM tasks WHERE id = 'TASK0001'").unwrap().unwrap()
        assert_eq(row.get_at(0) ?? "", "")
    }
}

