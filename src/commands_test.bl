test "set_task_status to done sets closed_at" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASK0001', 'T', 'open', 2)").unwrap()
        set_task_status("TASK0001", "done")
        let row = db.query_one("SELECT status, closed_at FROM tasks WHERE id = 'TASK0001'").unwrap().unwrap()
        assert_eq(row.get_at(0) ?? "", "done")
        assert(!(row.get_at(1) ?? "").is_empty())
    }
}

test "set_task_status reopen clears closed_at" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO tasks (id, title, status, priority, closed_at) VALUES ('TASK0001', 'T', 'done', 2, '2026-01-01T00:00:00Z')").unwrap()
        set_task_status("TASK0001", "open")
        let row = db.query_one("SELECT status, closed_at FROM tasks WHERE id = 'TASK0001'").unwrap().unwrap()
        assert_eq(row.get_at(0) ?? "", "open")
        assert_eq(row.get_at(1) ?? "", "")
    }
}

test "has_cycle detects transitive cycle" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKA001', 'A', 'open', 2)").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKB001', 'B', 'open', 2)").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKC001', 'C', 'open', 2)").unwrap()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_dep_add("TASKA001", "TASKB001")
            cmd_dep_add("TASKB001", "TASKC001")
        }
        // Adding C -> A next would close A -> B -> C -> A into a cycle.
        // This is the exact predicate cmd_dep_add checks before inserting;
        // exercised directly here because the rejecting branch calls exit(1),
        // which would abort the whole test binary if hit through cmd_dep_add.
        assert(has_cycle("TASKC001", "TASKA001"))
    }
}

test "cmd_dep_add accepts diamond dependency" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKA001', 'A', 'open', 2)").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKB001', 'B', 'open', 2)").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKC001', 'C', 'open', 2)").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASKD001', 'D', 'open', 2)").unwrap()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_dep_add("TASKA001", "TASKB001")
            cmd_dep_add("TASKA001", "TASKC001")
            cmd_dep_add("TASKB001", "TASKD001")
            cmd_dep_add("TASKC001", "TASKD001")
        }
        assert_eq(output.len(), 4)
        for line in output {
            assert(line.contains("blocks"))
        }
        let rows = db.query("SELECT blocker_id, blocked_id FROM deps").unwrap()
        assert_eq(rows.len(), 4)
    }
}

test "cmd_dep_add creates dependency" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASK0001', 'Blocker', 'open', 1)").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority) VALUES ('TASK0002', 'Blocked', 'open', 2)").unwrap()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_dep_add("TASK0001", "TASK0002")
        }
        assert_eq(output.len(), 1)
        assert((output.get(0) ?? "").contains("blocks"))

        let rows = db.query("SELECT blocker_id, blocked_id FROM deps").unwrap()
        assert_eq(rows.len(), 1)
        assert_eq(rows.get(0).unwrap().get_at(0) ?? "", "TASK0001")
        assert_eq(rows.get(0).unwrap().get_at(1) ?? "", "TASK0002")
    }
}

// --- Projects ---

fn project_id_by_name(name: Str) -> Str {
    let row = db.query_one("SELECT id FROM projects WHERE name = {name}").unwrap().unwrap()
    row.get_at(0) ?? ""
}

test "init_db adds project_id column to tasks" {
    with db.connect(":memory:") {
        setup_test_db()
        let cols = db.query("PRAGMA table_info(tasks)").unwrap()
        let mut has_project_id = false
        for col in cols {
            if (col.get_at(1) ?? "") == "project_id" {
                has_project_id = true
            }
        }
        assert(has_project_id)
    }
}

test "init_db is idempotent" {
    with db.connect(":memory:") {
        setup_test_db()
        setup_test_db()
        let cols = db.query("PRAGMA table_info(tasks)").unwrap()
        let mut project_id_count = 0
        for col in cols {
            if (col.get_at(1) ?? "") == "project_id" {
                project_id_count = project_id_count + 1
            }
        }
        assert_eq(project_id_count, 1)
    }
}

test "build_project_clause empty ref" {
