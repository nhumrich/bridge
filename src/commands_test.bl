test "project assignment does not affect ready/blocked DAG" {
    with db.connect(":memory:") {
        setup_test_db()
        db.exec("INSERT INTO projects (id, name) VALUES ('PROJ0001', 'launch')").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority, project_id) VALUES ('BLOCKER1', 'Blocker', 'open', 1, 'PROJ0001')").unwrap()
        db.exec("INSERT INTO tasks (id, title, status, priority, project_id) VALUES ('BLOCKED1', 'Blocked', 'open', 2, 'PROJ0001')").unwrap()
        db.exec("INSERT INTO deps (blocker_id, blocked_id) VALUES ('BLOCKER1', 'BLOCKED1')").unwrap()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_ready([], "launch", false)
        }
        assert_eq(output.len(), 1)
        assert((output.get(0) ?? "").contains("Blocker"))
        assert(!((output.get(0) ?? "").contains("Blocked")))
    }
}
