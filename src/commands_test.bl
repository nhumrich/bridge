test "cmd_project_add with tags inserts project_tags" {
    with db.connect(":memory:") {
        setup_test_db()
        let mut output: List[Str] = []
        with capture_print(output) {
            cmd_project_add("API Rewrite", "", ["team:backend", "q3"])
        }
        let pid = project_id_by_name("API Rewrite")
        let tag_rows = db.query("SELECT tag FROM project_tags WHERE project_id = {pid} ORDER BY tag ASC").unwrap()
        assert_eq(tag_rows.len(), 2)
        assert_eq(tag_rows.get(0).unwrap().get_at(0) ?? "", "q3")
        assert_eq(tag_rows.get(1).unwrap().get_at(0) ?? "", "team:backend")
    }
}

test "cmd_project_tag adds project_tags rows" {
