pub const CROCKFORD = "0123456789abcdefghjkmnpqrstvwxyz"

fn hex_to_int(hex: Str) -> Int {
    let mut value = 0
    let mut i = 0
    while i < hex.len() {
        let c = hex.slice(i, i + 1)
        value = value * 16
        if c == "0" { value = value + 0 }
        else if c == "1" { value = value + 1 }
        else if c == "2" { value = value + 2 }
        else if c == "3" { value = value + 3 }
        else if c == "4" { value = value + 4 }
        else if c == "5" { value = value + 5 }
        else if c == "6" { value = value + 6 }
        else if c == "7" { value = value + 7 }
        else if c == "8" { value = value + 8 }
        else if c == "9" { value = value + 9 }
        else if c == "a" { value = value + 10 }
        else if c == "b" { value = value + 11 }
        else if c == "c" { value = value + 12 }
        else if c == "d" { value = value + 13 }
        else if c == "e" { value = value + 14 }
        else if c == "f" { value = value + 15 }
        i = i + 1
    }
    value
}

fn base32_char(value: Int) -> Str {
    CROCKFORD.slice(value, value + 1)
}

// Takes 12 hex chars (6 random bytes). One byte -> one char: byte % 32 is
// unbiased because 256 % 32 == 0 — do not fold multiple bytes into one int,
// that's what caused the truncation bug this replaced.
pub fn id_from_hex(hex: Str) -> Str {
    let mut out: List[Str] = []
    let mut i = 0
    while i < hex.len() {
        let byte = hex_to_int(hex.slice(i, i + 2))
        out.push(base32_char(byte % 32))
        i = i + 2
    }
    out.join("")
}

pub fn id_from_seed(seed: Int) -> Str {
    let mut out: List[Str] = []
    let mut rem = seed
    let mut i = 0
    while i < 6 {
        out.push(base32_char(rem % 32))
        rem = rem / 32
        i = i + 1
    }
    out.join("")
}

// nonce only feeds the process_run-failure fallback: getpid() is constant and
// time_ms() may not advance across a tight no-sleep retry loop, so without it
// every fallback attempt in generate_unique_task_id/generate_unique_project_id
// would compute the identical seed and defeat the retry entirely.
pub fn generate_id(nonce: Int) -> Str {
    let result = process_run("sh", ["-c", "head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n'"])
    if result.exit_code != 0 {
        return id_from_seed(time_ms() * 1000 + getpid() + nonce)
    }
    id_from_hex(result.out.trim())
}

pub fn is_valid_id(s: Str) -> Bool {
    if s.len() != 6 {
        return false
    }
    let mut i = 0
    while i < s.len() {
        let c = s.slice(i, i + 1)
        if !CROCKFORD.contains(c) {
            return false
        }
        i = i + 1
    }
    true
}
