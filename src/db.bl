import std.db

pub fn db_path() -> Str {
    let home = env.var("HOME") ?? "/tmp"
    let dir = "{home}/.local/share/bridge"
    if is_dir(dir) == 0 {
        let result = process_run("mkdir", ["-p", dir])
        if result.exit_code != 0 {
            io.eprintln("Failed to create data directory: {result.err_out}")
            exit(1)
        }
    }
    "{dir}/bridge.db"
}

pub fn init_db() {
    db.query("PRAGMA busy_timeout=5000").unwrap()
    db.query("PRAGMA journal_mode=WAL").unwrap()
    db.query("PRAGMA foreign_keys=ON").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS tasks (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT DEFAULT '',
    status TEXT DEFAULT 'open' CHECK(status IN ('open','in_progress','done','cancelled')),
    priority INTEGER DEFAULT 2 CHECK(priority BETWEEN 0 AND 4),
    created_at TEXT DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
    updated_at TEXT DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
    closed_at TEXT
)").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS projects (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    description TEXT DEFAULT '',
    status TEXT DEFAULT 'active' CHECK(status IN ('active','done','archived')),
    created_at TEXT DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
    updated_at TEXT DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now'))
)").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS tags (
    task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    tag TEXT NOT NULL,
    PRIMARY KEY (task_id, tag)
)").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS project_tags (
    project_id TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
    tag TEXT NOT NULL,
    PRIMARY KEY (project_id, tag)
)").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS deps (
    blocker_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    blocked_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    PRIMARY KEY (blocker_id, blocked_id)
)").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS activity_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    action TEXT NOT NULL,
    session_id TEXT,
    project_path TEXT,
    created_at TEXT DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now'))
)").unwrap()
    db.exec("CREATE TABLE IF NOT EXISTS task_notes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    content TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'user' CHECK(source IN ('user','agent')),
    session_id TEXT,
    project_path TEXT,
    created_at TEXT DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now'))
)").unwrap()
    db.exec("CREATE INDEX IF NOT EXISTS idx_tags_tag ON tags(tag)").unwrap()
    db.exec("CREATE INDEX IF NOT EXISTS idx_project_tags_tag ON project_tags(tag)").unwrap()
    db.exec("CREATE INDEX IF NOT EXISTS idx_deps_blocked ON deps(blocked_id)").unwrap()
    db.exec("CREATE INDEX IF NOT EXISTS idx_deps_blocker ON deps(blocker_id)").unwrap()
    db.exec("CREATE INDEX IF NOT EXISTS idx_activity_task ON activity_log(task_id)").unwrap()
    db.exec("CREATE INDEX IF NOT EXISTS idx_notes_task ON task_notes(task_id)").unwrap()
    migrate_tasks_project_id()
    db.exec("CREATE INDEX IF NOT EXISTS idx_tasks_project ON tasks(project_id)").unwrap()
}

// SQLite has no `ADD COLUMN IF NOT EXISTS`; guard on PRAGMA table_info so this
// is a single idempotent path for both new and pre-projects databases.
fn migrate_tasks_project_id() {
    let cols = db.query("PRAGMA table_info(tasks)").unwrap()
    let mut has_project_id = false
    for col in cols {
        if (col.get_at(1) ?? "") == "project_id" {
            has_project_id = true
        }
    }
    if !has_project_id {
        db.exec("ALTER TABLE tasks ADD COLUMN project_id TEXT REFERENCES projects(id) ON DELETE SET NULL").unwrap()
    }
}
