import std.db
import ulid.{generate_id}
import display.{short_id, format_task_line, format_task_detail, format_activity_line, format_note_line, format_project_line}
import std.json.{json_new_array, json_new_object, json_set, json_new_str, json_push, json_encode, json_clear, json_parse, json_get, json_as_str, json_at, json_len}
import std.path.{path_join}

pub fn list_contains(items: List[Str], target: Str) -> Bool {
    for item in items {
        if item == target {
            return true
        }
    }
    false
}

pub fn sql_escape(s: Str) -> Str {
    s.replace("'", "''")
}

// Correlated subquery returning 1 if task t has at least one unresolved blocker.
pub fn is_blocked_sql() -> Str {
    "CASE WHEN EXISTS (SELECT 1 FROM deps d JOIN tasks b ON b.id = d.blocker_id WHERE d.blocked_id = t.id AND b.status NOT IN ('done', 'cancelled')) THEN 1 ELSE 0 END"
}

pub fn build_tag_clauses(tag_filters: List[Str]) -> List[Str] {
    let mut clauses: List[Str] = []
    for tag in tag_filters {
        let tf = sql_escape(tag)
        clauses.push("EXISTS (SELECT 1 FROM tags tg WHERE tg.task_id = t.id AND tg.tag = '{tf}')")
    }
    clauses
}

pub fn resolve_id(prefix: Str) -> Str {
    let pattern = "{prefix.to_lower()}%"
    let rows = db.query("SELECT id FROM tasks WHERE id LIKE {pattern}").unwrap()
    if rows.is_empty() {
        io.eprintln("No task matches prefix: {prefix}")
        exit(1)
    }
    if rows.len() > 1 {
        io.eprintln("Ambiguous prefix '{prefix}', multiple matches")
        exit(1)
    }
    let row = rows.get(0).unwrap()
    row.get_at(0) ?? ""
}

pub fn resolve_project_id(ref: Str) -> Str {
    let pattern = "{ref.to_lower()}%"
    let rows = db.query("SELECT id FROM projects WHERE name = {ref} OR id LIKE {pattern}").unwrap()
    if rows.is_empty() {
        io.eprintln("No project matches: {ref}")
        exit(1)
    }
    if rows.len() > 1 {
        io.eprintln("Ambiguous project '{ref}', multiple matches")
        exit(1)
    }
    let row = rows.get(0).unwrap()
    row.get_at(0) ?? ""
}

pub fn build_project_clause(project_ref: Str) -> Str {
    if project_ref.is_empty() {
        return ""
    }
    let pid = resolve_project_id(project_ref)
    "t.project_id = '{sql_escape(pid)}'"
}

fn project_name_for_task(task_id: Str) -> Str {
    let row = db.query_one("SELECT p.name FROM projects p JOIN tasks t ON t.project_id = p.id WHERE t.id = {task_id}").unwrap()
    match row {
        Some(r) => r.get_at(0) ?? ""
        None => ""
    }
}

fn tags_list_for_task(task_id: Str) -> List[Str] {
    let rows = db.query("SELECT tag FROM tags WHERE task_id = {task_id} ORDER BY tag ASC").unwrap()
    let mut tags: List[Str] = []
    for row in rows {
        let tag = row.get_at(0) ?? ""
        if !tag.is_empty() {
            tags.push(tag)
        }
    }
    tags
}

fn tags_for_task(task_id: Str) -> Str {
    tags_list_for_task(task_id).join(", ")
}


type TaskRow { id: Str, title: Str, priority: Int, status: Str, tags: Str, is_blocked: Bool }

fn parse_task_row(row: Row) -> TaskRow {
    TaskRow {
        id: row.get_at(0) ?? "",
        title: row.get_at(1) ?? "",
        priority: (row.get_at(2) ?? "2").to_int(),
        status: row.get_at(3) ?? "",
        tags: row.get_at(4) ?? "",
        is_blocked: false
    }
}

fn parse_task_row_with_blocked(row: Row, blocked_col: Int) -> TaskRow {
    TaskRow {
        id: row.get_at(0) ?? "",
        title: row.get_at(1) ?? "",
        priority: (row.get_at(2) ?? "2").to_int(),
        status: row.get_at(3) ?? "",
        tags: row.get_at(4) ?? "",
        is_blocked: (row.get_at(blocked_col) ?? "0").to_int() != 0
    }
}

fn parse_task_rows(rows: List[Row]) -> List[TaskRow] {
    let mut result: List[TaskRow] = []
    for row in rows {
        result.push(parse_task_row(row))
    }
    result
}

fn parse_task_rows_with_blocked(rows: List[Row], blocked_col: Int) -> List[TaskRow] {
    let mut result: List[TaskRow] = []
    for row in rows {
        result.push(parse_task_row_with_blocked(row, blocked_col))
    }
    result
}

fn print_task_rows(task_rows: List[TaskRow]) {
    for t in task_rows {
        io.println(format_task_line(t.id, t.title, t.priority, t.status, t.tags, t.is_blocked))
    }
}

fn rows_to_json(rows: List[Row], col_names: List[Str]) -> Str {
    let arr = json_new_array()
    for row in rows {
        let obj = json_new_object()
        let mut ci = 0
        while ci < col_names.len() {
            let name = col_names.get(ci) ?? ""
            let val = row.get_at(ci) ?? ""
            json_set(obj, name, json_new_str(val))
            ci = ci + 1
        }
        json_push(arr, obj)
    }
    json_encode(arr)
}

// --- Activity Logging ---

fn log_activity(task_id: Str, action: Str, session_id: Str) {
    let project_path = env.var("PWD") ?? ""
    let sid = env.var("BR_SESSION_ID") ?? session_id
    db.exec("INSERT INTO activity_log (task_id, action, session_id, project_path) VALUES ({task_id}, {action}, {sid}, {project_path})").unwrap()
}

pub fn cmd_note(id_prefix: Str, content: Str) {
    let id = resolve_id(id_prefix)
    let project_path = env.var("PWD") ?? ""
    let session_id = env.var("BR_SESSION_ID") ?? ""
    let source = if session_id.is_empty() { "user" } else { "agent" }
    db.exec("INSERT INTO task_notes (task_id, content, source, session_id, project_path) VALUES ({id}, {content}, {source}, {session_id}, {project_path})").unwrap()
    io.println("Note added to {short_id(id)}")
}

fn check_title_len(title: Str) {
    if title.len() > 120 {
        io.eprintln("Title too long (max 120 chars). Use -d for details.")
        exit(1)
    }
}

// --- CRUD Commands ---

pub fn cmd_add(title: Str, description: Str, priority: Int, tag_list: List[Str], project_ref: Str, session_id: Str) {
    check_title_len(title)
    let id = generate_id()
    if project_ref.is_empty() {
        db.exec("INSERT INTO tasks (id, title, description, priority) VALUES ({id}, {title}, {description}, {priority})").unwrap()
    } else {
        let pid = resolve_project_id(project_ref)
        db.exec("INSERT INTO tasks (id, title, description, priority, project_id) VALUES ({id}, {title}, {description}, {priority}, {pid})").unwrap()
    }

    for tag in tag_list {
        db.exec("INSERT OR IGNORE INTO tags (task_id, tag) VALUES ({id}, {tag})").unwrap()
    }

    log_activity(id, "created", session_id)
    io.println("Created: {short_id(id)}  {title}")
}

pub fn cmd_ls(status_filter: Str, tag_filters: List[Str], project_ref: Str, json_mode: Bool, show_closed: Bool, show_all: Bool) {
    let mut where_parts: List[Str] = []
    if !status_filter.is_empty() {
        let sf = sql_escape(status_filter)
        where_parts.push("t.status = '{sf}'")
    } else if show_closed {
        where_parts.push("t.status IN ('done', 'cancelled')")
    } else if !show_all {
        where_parts.push("t.status NOT IN ('done', 'cancelled')")
    }
    for clause in build_tag_clauses(tag_filters) {
        where_parts.push(clause)
    }
    let project_clause = build_project_clause(project_ref)
    if !project_clause.is_empty() {
        where_parts.push(project_clause)
    }
    let where_clause = if where_parts.len() == 0 { "" } else { " WHERE {where_parts.join(" AND ")}" }
    let blocked_col = is_blocked_sql()
    let rows = db.query("SELECT t.id, t.title, t.priority, t.status, COALESCE(GROUP_CONCAT(tg.tag, ', '), '') as tags, {Raw(blocked_col)} as is_blocked FROM tasks t LEFT JOIN tags tg ON tg.task_id = t.id{Raw(where_clause)} GROUP BY t.id ORDER BY t.priority ASC, t.created_at ASC").unwrap()

    if json_mode {
        io.println(rows_to_json(rows, ["id", "title", "priority", "status", "tags", "is_blocked"]))
        return
    }

    if rows.is_empty() {
        io.println("No tasks found.")
        return
    }

    print_task_rows(parse_task_rows_with_blocked(rows, 5))
}

pub fn cmd_show(id_prefix: Str, json_mode: Bool) {
    let id = resolve_id(id_prefix)
    let row = db.query_one("SELECT id, title, description, status, priority, created_at, updated_at, closed_at FROM tasks WHERE id = {id}").unwrap().unwrap()
    let note_rows = db.query("SELECT content, source, session_id, project_path, created_at FROM task_notes WHERE task_id = {id} ORDER BY created_at ASC").unwrap()

    if json_mode {
        let obj = json_new_object()
        let names = ["id", "title", "description", "status", "priority", "created_at", "updated_at", "closed_at"]
        let mut ci = 0
        while ci < names.len() {
            let name = names.get(ci) ?? ""
            let val = row.get_at(ci) ?? ""
            json_set(obj, name, json_new_str(val))
            ci = ci + 1
        }
        let notes_arr = json_new_array()
        for nr in note_rows {
            let note_obj = json_new_object()
            json_set(note_obj, "content", json_new_str(nr.get_at(0) ?? ""))
            json_set(note_obj, "source", json_new_str(nr.get_at(1) ?? ""))
            json_set(note_obj, "session_id", json_new_str(nr.get_at(2) ?? ""))
            json_set(note_obj, "project_path", json_new_str(nr.get_at(3) ?? ""))
            json_set(note_obj, "created_at", json_new_str(nr.get_at(4) ?? ""))
            json_push(notes_arr, note_obj)
        }
        json_set(obj, "notes", notes_arr)
        io.println(json_encode(obj))
        return
    }

    let title = row.get_at(1) ?? ""
    let description = row.get_at(2) ?? ""
    let status = row.get_at(3) ?? ""
    let priority = (row.get_at(4) ?? "2").to_int()
    let created_at = row.get_at(5) ?? ""
    let updated_at = row.get_at(6) ?? ""
    let closed_at = row.get_at(7) ?? ""
    let tags = tags_for_task(id)

    let blocks_rows = db.query("SELECT blocked_id FROM deps WHERE blocker_id = {id}").unwrap()
    let mut blocks_list: List[Str] = []
    for br in blocks_rows {
        blocks_list.push(short_id(br.get_at(0) ?? ""))
    }

    let blocked_by_rows = db.query("SELECT blocker_id FROM deps WHERE blocked_id = {id}").unwrap()
    let mut depends_on_list: List[Str] = []
    for bbr in blocked_by_rows {
        depends_on_list.push(short_id(bbr.get_at(0) ?? ""))
    }

    let unresolved = db.query("SELECT 1 FROM deps d JOIN tasks blocker ON blocker.id = d.blocker_id WHERE d.blocked_id = {id} AND blocker.status NOT IN ('done', 'cancelled') LIMIT 1").unwrap()
    let is_blocked = !unresolved.is_empty()
    let project = project_name_for_task(id)

    io.println(format_task_detail(id, title, description, status, priority, created_at, updated_at, closed_at, tags, project, blocks_list.join(", "), depends_on_list.join(", "), is_blocked))

    let activity_rows = db.query("SELECT action, session_id, project_path, created_at FROM activity_log WHERE task_id = {id} ORDER BY created_at ASC").unwrap()
    if !activity_rows.is_empty() {
        io.println("  Activity:")
        for ar in activity_rows {
            let aaction = ar.get_at(0) ?? ""
            let asession = ar.get_at(1) ?? ""
            let apath = ar.get_at(2) ?? ""
            let aat = ar.get_at(3) ?? ""
            io.println(format_activity_line(aaction, asession, apath, aat))
        }
    }

    if !note_rows.is_empty() {
        io.println("  Notes:")
        for nr in note_rows {
            let ncontent = nr.get_at(0) ?? ""
            let nsource = nr.get_at(1) ?? ""
            let nsession = nr.get_at(2) ?? ""
            let nat = nr.get_at(4) ?? ""
            io.println(format_note_line(ncontent, nsource, nsession, nat))
        }
    }
}

fn edit_task(id: Str, title: Str, description: Str, priority: Int, status: Str, project_ref: Str, clear_project: Bool, append: Bool) {
    if !title.is_empty() {
        check_title_len(title)
    }
    let mut sets: List[Str] = []
    if !title.is_empty() {
        sets.push("title = '{sql_escape(title)}'")
    }
    let has_desc = !description.is_empty()
    if priority >= 0 {
        sets.push("priority = {priority}")
    }
    if !status.is_empty() {
        sets.push("status = '{sql_escape(status)}'")
        if status == "done" || status == "cancelled" {
            sets.push("closed_at = strftime('%Y-%m-%dT%H:%M:%SZ','now')")
        } else if status == "open" || status == "in_progress" {
            sets.push("closed_at = NULL")
        }
    }
    if clear_project {
        sets.push("project_id = NULL")
    } else if !project_ref.is_empty() {
        let pid = resolve_project_id(project_ref)
        sets.push("project_id = '{sql_escape(pid)}'")
    }
    if sets.len() == 0 && !has_desc {
        io.eprintln("Nothing to update")
        exit(1)
    }
    sets.push("updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now')")
    let set_clause = sets.join(", ")
    let has_other = sets.len() > 1

    if has_other && has_desc {
        db.begin().unwrap()
        db.exec("UPDATE tasks SET {Raw(set_clause)} WHERE id = {id}").unwrap()
        if append {
            db.exec("UPDATE tasks SET description = description || '\n' || {description} WHERE id = {id}").unwrap()
        } else {
            db.exec("UPDATE tasks SET description = {description} WHERE id = {id}").unwrap()
        }
        db.commit().unwrap()
    } else if has_desc {
        if append {
            db.exec("UPDATE tasks SET description = description || '\n' || {description}, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id = {id}").unwrap()
        } else {
            db.exec("UPDATE tasks SET description = {description}, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id = {id}").unwrap()
        }
    } else {
        db.exec("UPDATE tasks SET {Raw(set_clause)} WHERE id = {id}").unwrap()
    }
    io.println("Updated: {short_id(id)}")
}

pub fn cmd_edit(id_prefix: Str, title: Str, description: Str, priority: Int, status: Str, project_ref: Str, clear_project: Bool, append: Bool) {
    let id = resolve_id(id_prefix)
    edit_task(id, title, description, priority, status, project_ref, clear_project, append)
}

pub fn cmd_start(id_prefix: Str, session_id: Str) {
    let id = resolve_id(id_prefix)
    edit_task(id, "", "", -1, "in_progress", "", false, false)
    log_activity(id, "started", session_id)
}

pub fn cmd_stop(id_prefix: Str, session_id: Str) {
    let id = resolve_id(id_prefix)
    edit_task(id, "", "", -1, "open", "", false, false)
    log_activity(id, "stopped", session_id)
}

pub fn cmd_done(id_prefix: Str, session_id: Str) {
    let id = resolve_id(id_prefix)
    edit_task(id, "", "", -1, "done", "", false, false)
    log_activity(id, "closed", session_id)
}

pub fn cmd_cancel(id_prefix: Str, session_id: Str) {
    let id = resolve_id(id_prefix)
    edit_task(id, "", "", -1, "cancelled", "", false, false)
    log_activity(id, "cancelled", session_id)
}

pub fn cmd_reopen(id_prefix: Str, session_id: Str) {
    let id = resolve_id(id_prefix)
    edit_task(id, "", "", -1, "open", "", false, false)
    log_activity(id, "reopened", session_id)
}

pub fn cmd_rm(id_prefix: Str) {
    let id = resolve_id(id_prefix)
    db.exec("DELETE FROM tasks WHERE id = {id}").unwrap()
    io.println("Deleted: {short_id(id)}")
}

// --- Project Commands ---

pub fn cmd_project_add(name: Str, description: Str) {
    let existing = db.query("SELECT id FROM projects WHERE name = {name}").unwrap()
    if !existing.is_empty() {
        io.eprintln("Project name already taken: {name}")
        exit(1)
    }
    let id = generate_id()
    db.exec("INSERT INTO projects (id, name, description) VALUES ({id}, {name}, {description})").unwrap()
    io.println("Created project: {short_id(id)}  {name}")
}

pub fn cmd_project_ls(json_mode: Bool) {
    let rows = db.query("SELECT p.id, p.name, p.status, COALESCE(SUM(CASE WHEN t.status IN ('done', 'cancelled') THEN 1 ELSE 0 END), 0) as done, COUNT(t.id) as total FROM projects p LEFT JOIN tasks t ON t.project_id = p.id GROUP BY p.id ORDER BY p.created_at ASC").unwrap()

    if json_mode {
        io.println(rows_to_json(rows, ["id", "name", "status", "done", "total"]))
        return
    }

    if rows.is_empty() {
        io.println("No projects found.")
        return
    }

    for row in rows {
        let id = row.get_at(0) ?? ""
        let name = row.get_at(1) ?? ""
        let status = row.get_at(2) ?? ""
        let done = (row.get_at(3) ?? "0").to_int()
        let total = (row.get_at(4) ?? "0").to_int()
        io.println(format_project_line(id, name, status, done, total))
    }
}

pub fn cmd_project_show(ref: Str, json_mode: Bool) {
    let id = resolve_project_id(ref)
    let row = db.query_one("SELECT id, name, description, status, created_at, updated_at FROM projects WHERE id = {id}").unwrap().unwrap()
    let name = row.get_at(1) ?? ""
    let description = row.get_at(2) ?? ""
    let status = row.get_at(3) ?? ""
    let created_at = row.get_at(4) ?? ""
    let updated_at = row.get_at(5) ?? ""

    let blocked_col = is_blocked_sql()
    let task_rows = db.query("SELECT t.id, t.title, t.priority, t.status, COALESCE(GROUP_CONCAT(tg.tag, ', '), '') as tags, {Raw(blocked_col)} as is_blocked FROM tasks t LEFT JOIN tags tg ON tg.task_id = t.id WHERE t.project_id = {id} GROUP BY t.id ORDER BY t.priority ASC, t.created_at ASC").unwrap()

    if json_mode {
        let obj = json_new_object()
        json_set(obj, "id", json_new_str(id))
        json_set(obj, "name", json_new_str(name))
        json_set(obj, "description", json_new_str(description))
        json_set(obj, "status", json_new_str(status))
        json_set(obj, "created_at", json_new_str(created_at))
        json_set(obj, "updated_at", json_new_str(updated_at))
        let tasks_arr = json_new_array()
        for tr in task_rows {
            let tobj = json_new_object()
            json_set(tobj, "id", json_new_str(tr.get_at(0) ?? ""))
            json_set(tobj, "title", json_new_str(tr.get_at(1) ?? ""))
            json_set(tobj, "priority", json_new_str(tr.get_at(2) ?? ""))
            json_set(tobj, "status", json_new_str(tr.get_at(3) ?? ""))
            json_set(tobj, "tags", json_new_str(tr.get_at(4) ?? ""))
            json_push(tasks_arr, tobj)
        }
        json_set(obj, "tasks", tasks_arr)
        io.println(json_encode(obj))
        return
    }

    let mut done = 0
    let total = task_rows.len()
    for tr in task_rows {
        let st = tr.get_at(3) ?? ""
        if st == "done" || st == "cancelled" {
            done = done + 1
        }
    }

    io.println("Project: {short_id(id)}")
    io.println("  Full ID:  {id}")
    io.println("  Name:     {name}")
    io.println("  Status:   {status}")
    io.println("  Progress: {done}/{total}")
    io.println("  Desc:     {description}")
    io.println("  Created:  {created_at}")
    io.println("  Updated:  {updated_at}")

    if task_rows.is_empty() {
        io.println("  Tasks:    (none)")
        return
    }
    io.println("  Tasks:")
    print_task_rows(parse_task_rows_with_blocked(task_rows, 5))
}

pub fn cmd_project_edit(ref: Str, name: Str, description: Str, status: Str) {
    let id = resolve_project_id(ref)
    let mut sets: List[Str] = []
    if !name.is_empty() {
        sets.push("name = '{sql_escape(name)}'")
    }
    if !status.is_empty() {
        let valid = ["active", "done", "archived"]
        if !list_contains(valid, status) {
            io.eprintln("Invalid status: {status} (must be active, done, or archived)")
            exit(1)
        }
        sets.push("status = '{sql_escape(status)}'")
    }
    let has_desc = !description.is_empty()
    if sets.len() == 0 && !has_desc {
        io.eprintln("Nothing to update")
        exit(1)
    }
    sets.push("updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now')")
    let set_clause = sets.join(", ")
    if has_desc {
        db.begin().unwrap()
        db.exec("UPDATE projects SET {Raw(set_clause)} WHERE id = {id}").unwrap()
        db.exec("UPDATE projects SET description = {description} WHERE id = {id}").unwrap()
        db.commit().unwrap()
    } else {
        db.exec("UPDATE projects SET {Raw(set_clause)} WHERE id = {id}").unwrap()
    }
    io.println("Updated project: {short_id(id)}")
}

pub fn cmd_project_rm(ref: Str) {
    let id = resolve_project_id(ref)
    db.exec("DELETE FROM projects WHERE id = {id}").unwrap()
    io.println("Deleted project: {short_id(id)}")
}

// --- DAG Commands ---

pub fn cmd_ready(tag_filters: List[Str], project_ref: Str, json_mode: Bool) {
    let mut tag_clause = ""
    let tag_clauses = build_tag_clauses(tag_filters)
    if !tag_clauses.is_empty() {
        tag_clause = " AND {tag_clauses.join(" AND ")}"
    }
    let project_clause = build_project_clause(project_ref)
    if !project_clause.is_empty() {
        tag_clause = "{tag_clause} AND {project_clause}"
    }
    let rows = db.query("SELECT t.id, t.title, t.priority, t.status, COALESCE(GROUP_CONCAT(tg.tag, ', '), '') as tags FROM tasks t LEFT JOIN tags tg ON tg.task_id = t.id WHERE t.status IN ('open', 'in_progress') AND NOT EXISTS (SELECT 1 FROM deps d JOIN tasks blocker ON blocker.id = d.blocker_id WHERE d.blocked_id = t.id AND blocker.status NOT IN ('done', 'cancelled')){Raw(tag_clause)} GROUP BY t.id ORDER BY t.priority ASC, t.created_at ASC").unwrap()

    if json_mode {
        io.println(rows_to_json(rows, ["id", "title", "priority", "status", "tags"]))
        return
    }

    if rows.is_empty() {
        io.println("No ready tasks.")
        return
    }

    print_task_rows(parse_task_rows(rows))
}

fn has_cycle(from_id: Str, to_id: Str) -> Bool {
    let all_deps = db.query("SELECT blocker_id, blocked_id FROM deps").unwrap()
    let mut adj: Map[Str, List[Str]] = Map()
    for dep in all_deps {
        let blocker = dep.get_at(0) ?? ""
        let blocked = dep.get_at(1) ?? ""
        let mut children = map_get_list(adj, blocker)
        children.push(blocked)
        adj.insert(blocker, children)
    }

    let mut visited: List[Str] = []
    let mut stack: List[Str] = [to_id]

    while stack.len() > 0 {
        let current = stack.get(stack.len() - 1) ?? ""
        stack.pop()
        if current == from_id {
            return true
        }
        if list_contains(visited, current) {
            // already visited
        } else {
            visited.push(current)
            let deps_list = map_get_list(adj, current)
            for did in deps_list {
                if !did.is_empty() {
                    stack.push(did)
                }
            }
        }
    }
    false
}

pub fn cmd_dep_add(blocker_prefix: Str, blocked_prefix: Str) {
    let blocker_id = resolve_id(blocker_prefix)
    let blocked_id = resolve_id(blocked_prefix)

    if blocker_id == blocked_id {
        io.eprintln("A task cannot block itself")
        exit(1)
    }

    if has_cycle(blocker_id, blocked_id) {
        io.eprintln("Cannot add dependency: would create a cycle")
        exit(1)
    }

    db.exec("INSERT OR IGNORE INTO deps (blocker_id, blocked_id) VALUES ({blocker_id}, {blocked_id})").unwrap()
    io.println("Added: {short_id(blocker_id)} blocks {short_id(blocked_id)}")
}

pub fn cmd_dep_rm(blocker_prefix: Str, blocked_prefix: Str) {
    let blocker_id = resolve_id(blocker_prefix)
    let blocked_id = resolve_id(blocked_prefix)
    db.exec("DELETE FROM deps WHERE blocker_id = {blocker_id} AND blocked_id = {blocked_id}").unwrap()
    io.println("Removed: {short_id(blocker_id)} no longer blocks {short_id(blocked_id)}")
}

pub fn cmd_blocked(tag_filters: List[Str], project_ref: Str, json_mode: Bool) {
    let mut tag_clause = ""
    let tag_clauses = build_tag_clauses(tag_filters)
    if !tag_clauses.is_empty() {
        tag_clause = " AND {tag_clauses.join(" AND ")}"
    }
    let project_clause = build_project_clause(project_ref)
    if !project_clause.is_empty() {
        tag_clause = "{tag_clause} AND {project_clause}"
    }
    let rows = db.query("SELECT t.id, t.title, t.priority, t.status, COALESCE(GROUP_CONCAT(DISTINCT tg.tag), '') as tags, COALESCE(GROUP_CONCAT(DISTINCT d.blocker_id), '') as blockers FROM tasks t JOIN deps d ON d.blocked_id = t.id LEFT JOIN tags tg ON tg.task_id = t.id WHERE t.status NOT IN ('done', 'cancelled') AND EXISTS (SELECT 1 FROM deps d2 JOIN tasks blocker ON blocker.id = d2.blocker_id WHERE d2.blocked_id = t.id AND blocker.status NOT IN ('done', 'cancelled')){Raw(tag_clause)} GROUP BY t.id ORDER BY t.priority ASC").unwrap()

    if json_mode {
        io.println(rows_to_json(rows, ["id", "title", "priority", "status", "tags", "blockers"]))
        return
    }

    if rows.is_empty() {
        io.println("No blocked tasks.")
        return
    }

    for row in rows {
        let t = parse_task_row(row)
        let blockers = row.get_at(5) ?? ""
        let line = format_task_line(t.id, t.title, t.priority, t.status, t.tags, true)
        io.println("{line}  (blocked by: {blockers})")
    }
}

// --- Graph Command ---

fn map_get_list(m: Map[Str, List[Str]], key: Str) -> List[Str] {
    match m.get(key) {
        Some(v) => v
        None => {
            let empty: List[Str] = []
            empty
        }
    }
}


type TreeCtx {
    tasks: Map[Str, TaskRow],
    children: Map[Str, List[Str]],
    visited: Map[Str, Bool],
    target_id: Str
}

fn render_tree(task_id: Str, prefix: Str, is_last: Bool, is_root: Bool, ctx: TreeCtx) {
    let t = ctx.tasks.get(task_id).unwrap()
    let line = format_task_line(t.id, t.title, t.priority, t.status, t.tags, t.is_blocked)

    let connector = if is_root { "" } else if is_last { "└── " } else { "├── " }
    let marker = if !ctx.target_id.is_empty() && task_id == ctx.target_id { "  <--" } else { "" }

    let already_visited = ctx.visited.contains_key(task_id)
    let suffix = if already_visited { "  ..." } else { "" }

    io.println("{prefix}{connector}{line}{marker}{suffix}")

    if already_visited {
        return
    }
    ctx.visited.insert(task_id, true)

    let child_list = map_get_list(ctx.children, task_id)
    let mut i = 0
    while i < child_list.len() {
        let child_id = child_list.get(i) ?? ""
        let child_is_last = i == child_list.len() - 1
        let child_prefix = if is_root { prefix } else if is_last { "{prefix}    " } else { "{prefix}│   " }
        render_tree(child_id, child_prefix, child_is_last, false, ctx)
        i = i + 1
    }
}

pub fn cmd_graph(id_prefix: Str, tag_filters: List[Str], show_all: Bool) {
    let mut where_parts: List[Str] = []
    if !show_all {
        where_parts.push("t.status NOT IN ('done', 'cancelled')")
    }
    for clause in build_tag_clauses(tag_filters) {
        where_parts.push(clause)
    }
    let where_clause = if where_parts.is_empty() { "" } else { " WHERE {where_parts.join(" AND ")}" }
    let blocked_col = is_blocked_sql()
    let rows = db.query("SELECT t.id, t.title, t.priority, t.status, COALESCE(GROUP_CONCAT(tg.tag, ', '), '') as tags, {Raw(blocked_col)} as is_blocked FROM tasks t LEFT JOIN tags tg ON tg.task_id = t.id{Raw(where_clause)} GROUP BY t.id ORDER BY t.priority ASC, t.created_at ASC").unwrap()

    if rows.is_empty() {
        io.println("No tasks found.")
        return
    }

    let mut tasks: Map[Str, TaskRow] = Map()
    for row in rows {
        let t = parse_task_row_with_blocked(row, 5)
        tasks.insert(t.id, t)
    }

    let edge_rows = db.query("SELECT blocker_id, blocked_id FROM deps").unwrap()

    let target_id = if !id_prefix.is_empty() { resolve_id(id_prefix) } else { "" }

    if !target_id.is_empty() {
        let mut fwd: Map[Str, List[Str]] = Map()
        let mut rev: Map[Str, List[Str]] = Map()
        for er in edge_rows {
            let blocker = er.get_at(0) ?? ""
            let blocked = er.get_at(1) ?? ""
            if tasks.contains_key(blocker) && tasks.contains_key(blocked) {
                let mut fl = map_get_list(fwd, blocker)
                fl.push(blocked)
                fwd.insert(blocker, fl)
                let mut rl = map_get_list(rev, blocked)
                rl.push(blocker)
                rev.insert(blocked, rl)
            }
        }

        let mut component: Map[Str, Bool] = Map()
        let mut stack: List[Str] = [target_id]
        while !stack.is_empty() {
            let current = stack.get(stack.len() - 1) ?? ""
            stack.pop()
            if !component.contains_key(current) {
                component.insert(current, true)
                let fwd_list = map_get_list(fwd, current)
                for child in fwd_list {
                    if !component.contains_key(child) { stack.push(child) }
                }
                let rev_list = map_get_list(rev, current)
                for parent in rev_list {
                    if !component.contains_key(parent) { stack.push(parent) }
                }
            }
        }

        let mut remove_ids: List[Str] = []
        let all_ids = tasks.keys()
        for tid in all_ids {
            if !component.contains_key(tid) {
                remove_ids.push(tid)
            }
        }
        for rid in remove_ids {
            tasks.remove(rid)
        }
    }

    let mut children: Map[Str, List[Str]] = Map()
    let mut has_parent: Map[Str, Bool] = Map()
    for er in edge_rows {
        let blocker = er.get_at(0) ?? ""
        let blocked = er.get_at(1) ?? ""
        if tasks.contains_key(blocker) && tasks.contains_key(blocked) {
            let mut child_list = map_get_list(children, blocker)
            child_list.push(blocked)
            children.insert(blocker, child_list)
            has_parent.insert(blocked, true)
        }
    }

    let mut roots: List[Str] = []
    for row in rows {
        let id = row.get_at(0) ?? ""
        if tasks.contains_key(id) && !has_parent.contains_key(id) {
            roots.push(id)
        }
    }

    if roots.is_empty() {
        io.println("No tasks found.")
        return
    }

    let ctx = TreeCtx {
        tasks: tasks,
        children: children,
        visited: Map(),
        target_id: target_id
    }
    for root in roots {
        render_tree(root, "", false, true, ctx)
    }
}

// --- Tag Commands ---

pub fn cmd_tag(id_prefix: Str, tags: List[Str]) {
    let id = resolve_id(id_prefix)
    for tag in tags {
        db.exec("INSERT OR IGNORE INTO tags (task_id, tag) VALUES ({id}, {tag})").unwrap()
    }
    io.println("Tagged: {short_id(id)}")
}

pub fn cmd_untag(id_prefix: Str, tags: List[Str]) {
    let id = resolve_id(id_prefix)
    for tag in tags {
        db.exec("DELETE FROM tags WHERE task_id = {id} AND tag = {tag}").unwrap()
    }
    io.println("Untagged: {short_id(id)}")
}

pub fn cmd_tags() {
    let rows = db.query("SELECT tag, COUNT(*) as count FROM tags GROUP BY tag ORDER BY count DESC, tag ASC").unwrap()
    if rows.is_empty() {
        io.println("No tags found.")
        return
    }
    for row in rows {
        let tag = row.get_at(0) ?? ""
        let cnt = (row.get_at(1) ?? "0").to_int()
        io.println("  {tag}  ({cnt})")
    }
}

pub fn cmd_stats(tag_filters: List[Str], project_ref: Str) {
    let mut tag_joins: List[Str] = []
    let mut tag_wheres: List[Str] = []
    let mut ti = 0
    for tag in tag_filters {
        let tf = sql_escape(tag)
        tag_joins.push(" JOIN tags tg{ti} ON tg{ti}.task_id = t.id")
        tag_wheres.push("tg{ti}.tag = '{tf}'")
        ti = ti + 1
    }
    let project_clause = build_project_clause(project_ref)
    if !project_clause.is_empty() {
        tag_wheres.push(project_clause)
    }
    let tag_join = tag_joins.join("")
    let tag_where = if tag_wheres.is_empty() { "" } else { " WHERE {tag_wheres.join(" AND ")}" }
    let rows = db.query("SELECT t.status, COUNT(*) as count FROM tasks t{Raw(tag_join)}{Raw(tag_where)} GROUP BY t.status ORDER BY t.status").unwrap()
    if rows.is_empty() {
        io.println("No tasks.")
        return
    }
    io.println("Tasks:")
    for row in rows {
        let status = row.get_at(0) ?? ""
        let cnt = (row.get_at(1) ?? "0").to_int()
        io.println("  {status}: {cnt}")
    }
}

pub fn cmd_vi(id_prefix: Str) {
    let id = resolve_id(id_prefix)
    let sid = short_id(id)

    let row = db.query_one("SELECT title, description, status, priority FROM tasks WHERE id = {id}").unwrap().unwrap()
    let old_title = row.get_at(0) ?? ""
    let old_desc = row.get_at(1) ?? ""
    let old_status = row.get_at(2) ?? "open"
    let old_priority = (row.get_at(3) ?? "2").to_int()

    let old_tags = tags_list_for_task(id)
    let old_tags_str = old_tags.join(", ")

    let mut lines: List[Str] = []
    lines.push("# Edit task {sid}. Lines starting with # are ignored.")
    lines.push("# Fields: title, priority (P0-P4), status (open/in_progress/done/cancelled), tags (comma-separated)")
    lines.push("# Everything below --- is the description (freeform).")
    lines.push("title: {old_title}")
    lines.push("priority: P{old_priority}")
    lines.push("status: {old_status}")
    lines.push("tags: {old_tags_str}")
    lines.push("---")
    lines.push(old_desc)
    let content = lines.join("\n")

    let tmp_path = "/tmp/br-edit-{sid}.txt"
    write_file(tmp_path, content)

    let editor = env.var("EDITOR") ?? "vi"
    let exit_code = shell_exec("{editor} {tmp_path}")
    if exit_code != 0 {
        process_run("rm", ["-f", tmp_path])
        io.eprintln("Editor exited with error, aborting.")
        exit(1)
    }

    let new_content = read_file(tmp_path)
    process_run("rm", ["-f", tmp_path])

    if new_content.trim() == content.trim() {
        io.println("Nothing changed.")
        return
    }

    let mut header = ""
    let mut body = ""
    let sep_idx = new_content.index_of("\n---\n")
    if sep_idx >= 0 {
        header = new_content.slice(0, sep_idx)
        body = new_content.slice(sep_idx + 5, new_content.len())
    } else if new_content.ends_with("\n---") {
        header = new_content.slice(0, new_content.len() - 4)
        body = ""
    } else {
        header = new_content
        body = ""
    }

    let mut new_title = ""
    let mut new_priority = -1
    let mut new_status = ""
    let mut new_tags_str = ""

    let header_lines = header.lines()
    for line in header_lines {
        let trimmed = line.trim()
        if trimmed.is_empty() || trimmed.starts_with("#") {
            // skip
        } else if trimmed.starts_with("title:") {
            new_title = trimmed.slice(6, trimmed.len()).trim()
        } else if trimmed.starts_with("priority:") {
            let pval = trimmed.slice(9, trimmed.len()).trim().to_upper()
            if pval.starts_with("P") {
                new_priority = pval.slice(1, pval.len()).to_int()
            } else {
                new_priority = pval.to_int()
            }
        } else if trimmed.starts_with("status:") {
            new_status = trimmed.slice(7, trimmed.len()).trim()
        } else if trimmed.starts_with("tags:") {
            new_tags_str = trimmed.slice(5, trimmed.len()).trim()
        }
    }

    let new_desc = body.trim()

    if new_title.is_empty() {
        io.eprintln("Error: title cannot be empty")
        exit(1)
    }
    check_title_len(new_title)

    let valid_statuses = ["open", "in_progress", "done", "cancelled"]
    if !new_status.is_empty() && !list_contains(valid_statuses, new_status) {
        io.eprintln("Invalid status: {new_status} (must be open, in_progress, done, or cancelled)")
        exit(1)
    }

    if new_priority < 0 || new_priority > 4 {
        io.eprintln("Invalid priority: must be P0-P4")
        exit(1)
    }

    let mut sets: List[Str] = []
    let mut changes: List[Str] = []
    let mut desc_changed = false

    if new_title != old_title {
        sets.push("title = '{sql_escape(new_title)}'")
        changes.push("title")
    }
    if new_desc != old_desc.trim() {
        desc_changed = true
        changes.push("description")
    }
    if new_priority != old_priority {
        sets.push("priority = {new_priority}")
        changes.push("priority")
    }
    if !new_status.is_empty() && new_status != old_status {
        sets.push("status = '{sql_escape(new_status)}'")
        if new_status == "done" || new_status == "cancelled" {
            sets.push("closed_at = strftime('%Y-%m-%dT%H:%M:%SZ','now')")
        }
        changes.push("status")
    }

    let mut new_tags: List[Str] = []
    if !new_tags_str.is_empty() {
        let parts = new_tags_str.split(",")
        for part in parts {
            let t = part.trim()
            if !t.is_empty() { new_tags.push(t) }
        }
    }

    let mut tags_added: List[Str] = []
    let mut tags_removed: List[Str] = []
    for nt in new_tags {
        if !list_contains(old_tags, nt) {
            tags_added.push(nt)
        }
    }
    for ot in old_tags {
        if !list_contains(new_tags, ot) {
            tags_removed.push(ot)
        }
    }

    if sets.is_empty() && !desc_changed && tags_added.is_empty() && tags_removed.is_empty() {
        io.println("Nothing changed.")
        return
    }

    if !sets.is_empty() && desc_changed {
        sets.push("updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now')")
        let set_clause = sets.join(", ")
        db.begin().unwrap()
        db.exec("UPDATE tasks SET {Raw(set_clause)} WHERE id = {id}").unwrap()
        db.exec("UPDATE tasks SET description = {new_desc} WHERE id = {id}").unwrap()
        db.commit().unwrap()
    } else if desc_changed {
        db.exec("UPDATE tasks SET description = {new_desc}, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id = {id}").unwrap()
    } else if !sets.is_empty() {
        sets.push("updated_at = strftime('%Y-%m-%dT%H:%M:%SZ','now')")
        let set_clause = sets.join(", ")
        db.exec("UPDATE tasks SET {Raw(set_clause)} WHERE id = {id}").unwrap()
    }

    for ta in tags_added {
        db.exec("INSERT OR IGNORE INTO tags (task_id, tag) VALUES ({id}, {ta})").unwrap()
        changes.push("+tag:{ta}")
    }
    for tr in tags_removed {
        db.exec("DELETE FROM tags WHERE task_id = {id} AND tag = {tr}").unwrap()
        changes.push("-tag:{tr}")
    }

    log_activity(id, "edited", "")
    io.println("Updated {sid}: {changes.join(", ")}")
}

pub fn cmd_install() {
    let home = env.var("HOME") ?? "/tmp"
    let dest_dir = "{home}/.claude/commands"

    let result = process_run("mkdir", ["-p", dest_dir])
    if result.exit_code != 0 {
        io.eprintln("Failed to create {dest_dir}")
        exit(1)
    }

    const CMD_ADD = #embed("../commands/br-add.md")
    const CMD_CLOSE = #embed("../commands/br-close.md")
    const CMD_NEXT = #embed("../commands/br-next.md")
    const CMD_NOTE = #embed("../commands/br-note.md")
    const CMD_PLAN = #embed("../commands/br-plan.md")

    let names = ["br:add.md", "br:close.md", "br:next.md", "br:note.md", "br:plan.md"]
    let contents = [CMD_ADD, CMD_CLOSE, CMD_NEXT, CMD_NOTE, CMD_PLAN]

    let mut i = 0
    while i < names.len() {
        let name = names.get(i) ?? ""
        let content = contents.get(i) ?? ""
        let dest = path_join(dest_dir, name)
        write_file(dest, content)
        io.println("  Installed: {name}")
        i = i + 1
    }
    io.println("Installed {names.len()} commands to {dest_dir}")

    install_bridge_md(home)
    install_hook(home)
}

fn install_bridge_md(home: Str) {
    const BRIDGE_MD = #embed("../commands/bridge.md")
    let bridge_path = "{home}/.claude/bridge.md"
    write_file(bridge_path, BRIDGE_MD)
    io.println("  Installed: bridge.md")

    let claude_md_path = "{home}/.claude/CLAUDE.md"
    if file_exists(claude_md_path) == 1 {
        let content = read_file(claude_md_path)
        if !content.contains("@bridge.md") {
            write_file(claude_md_path, "{content}\n@bridge.md")
            io.println("  Added @bridge.md to CLAUDE.md")
        } else {
            io.println("  CLAUDE.md: @bridge.md already present")
        }
    } else {
        write_file(claude_md_path, "@bridge.md\n")
        io.println("  Created CLAUDE.md with @bridge.md")
    }
}

fn install_hook(home: Str) {
    let settings_path = "{home}/.claude/settings.json"
    let hook_cmd = #"bash -c 'read input; sid=$(echo "$input" | sed -n '"'"'s/.*"session_id":"\([^"]*\)".*/\1/p'"'"'); [ -n "$CLAUDE_ENV_FILE" ] && [ -n "$sid" ] && echo "export BR_SESSION_ID=$sid" >> "$CLAUDE_ENV_FILE"'"#

    json_clear()
    let mut root = -1
    if file_exists(settings_path) == 1 {
        let content = read_file(settings_path)
        if !content.trim().is_empty() {
            root = json_parse(content)
        }
    }
    if root == -1 {
        root = json_new_object()
    }

    let mut hooks_node = json_get(root, "hooks")
    if hooks_node == -1 {
        hooks_node = json_new_object()
        json_set(root, "hooks", hooks_node)
    }

    let mut ss_arr = json_get(hooks_node, "SessionStart")
    if ss_arr == -1 {
        ss_arr = json_new_array()
        json_set(hooks_node, "SessionStart", ss_arr)
    }

    let mut already_installed = false
    let mut idx = 0
    while idx < json_len(ss_arr) {
        let entry = json_at(ss_arr, idx)
        let inner_hooks = json_get(entry, "hooks")
        if inner_hooks != -1 {
            let mut j = 0
            while j < json_len(inner_hooks) {
                let h = json_at(inner_hooks, j)
                let cmd_node = json_get(h, "command")
                if cmd_node != -1 {
                    let cmd = json_as_str(cmd_node)
                    if cmd.contains("BR_SESSION_ID") {
                        already_installed = true
                    }
                }
                j = j + 1
            }
        }
        idx = idx + 1
    }

    if already_installed {
        io.println("  Hook: already installed")
        return
    }

    let hook_obj = json_new_object()
    json_set(hook_obj, "type", json_new_str("command"))
    json_set(hook_obj, "command", json_new_str(hook_cmd))

    let inner_arr = json_new_array()
    json_push(inner_arr, hook_obj)

    let entry = json_new_object()
    json_set(entry, "hooks", inner_arr)

    json_push(ss_arr, entry)

    write_file(settings_path, json_encode(root))
    io.println("  Hook: SessionStart (BR_SESSION_ID)")
}

pub fn cmd_uninstall() {
    let home = env.var("HOME") ?? "/tmp"
    let dest_dir = "{home}/.claude/commands"
    let names = ["br:add.md", "br:close.md", "br:next.md", "br:note.md", "br:plan.md"]
    let mut removed = 0
    for name in names {
        let dest = path_join(dest_dir, name)
        if file_exists(dest) == 1 {
            process_run("rm", ["-f", dest])
            io.println("  Removed: {name}")
            removed = removed + 1
        }
    }
    if removed == 0 {
        io.println("Nothing to uninstall.")
    } else {
        io.println("Removed {removed} commands")
    }

    uninstall_bridge_md(home)
    uninstall_hook(home)
}

fn uninstall_bridge_md(home: Str) {
    let bridge_path = "{home}/.claude/bridge.md"
    if file_exists(bridge_path) == 1 {
        process_run("rm", ["-f", bridge_path])
        io.println("  Removed: bridge.md")
    }

    let claude_md_path = "{home}/.claude/CLAUDE.md"
    if file_exists(claude_md_path) == 1 {
        let content = read_file(claude_md_path)
        if content.contains("@bridge.md") {
            let updated = content.replace("\n@bridge.md", "").replace("@bridge.md\n", "")
            write_file(claude_md_path, updated)
            io.println("  Removed @bridge.md from CLAUDE.md")
        }
    }
}

fn uninstall_hook(home: Str) {
    let settings_path = "{home}/.claude/settings.json"
    if file_exists(settings_path) == 0 {
        return
    }

    let content = read_file(settings_path)
    if content.trim().is_empty() {
        return
    }

    json_clear()
    let root = json_parse(content)
    if root == -1 {
        return
    }

    let hooks_node = json_get(root, "hooks")
    if hooks_node == -1 {
        return
    }

    let ss_arr = json_get(hooks_node, "SessionStart")
    if ss_arr == -1 {
        return
    }

    let mut new_arr = json_new_array()
    let mut removed = false
    let mut idx = 0
    while idx < json_len(ss_arr) {
        let entry = json_at(ss_arr, idx)
        let mut is_ours = false
        let inner_hooks = json_get(entry, "hooks")
        if inner_hooks != -1 {
            let mut j = 0
            while j < json_len(inner_hooks) {
                let h = json_at(inner_hooks, j)
                let cmd_node = json_get(h, "command")
                if cmd_node != -1 {
                    let cmd = json_as_str(cmd_node)
                    if cmd.contains("BR_SESSION_ID") {
                        is_ours = true
                    }
                }
                j = j + 1
            }
        }
        if is_ours {
            removed = true
        } else {
            json_push(new_arr, entry)
        }
        idx = idx + 1
    }

    if removed {
        json_set(hooks_node, "SessionStart", new_arr)
        write_file(settings_path, json_encode(root))
        io.println("  Removed: SessionStart hook")
    }
}
