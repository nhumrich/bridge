import std.term

fn use_color() -> Bool {
    let no_color = env.var("NO_COLOR") ?? ""
    if !no_color.is_empty() { return false }
    term.is_tty()
}

pub fn short_id(id: Str) -> Str {
    if id.len() > 8 {
        return id.slice(0, 8)
    }
    id
}

pub fn format_priority(p: Int) -> Str {
    let label = if p == 0 { "P0" }
        else if p == 1 { "P1" }
        else if p == 2 { "P2" }
        else if p == 3 { "P3" }
        else { "P4" }
    if !use_color() { return label }
    if p == 0 { return term.bold(term.red(label)) }
    if p == 1 { return term.red(label) }
    if p == 2 { return term.yellow(label) }
    if p == 4 { return term.dim(label) }
    label
}

pub fn format_status(status: Str, blocked: Bool) -> Str {
    if blocked && (status == "open" || status == "in_progress") {
        let s = "[!]"
        if use_color() { return term.red(s) }
        return s
    }
    if status == "open" { return "[ ]" }
    if status == "in_progress" {
        let s = "[~]"
        if use_color() { return term.yellow(s) }
        return s
    }
    if status == "done" {
        let s = "[x]"
        if use_color() { return term.green(s) }
        return s
    }
    let s = "[-]"
    if use_color() { return term.dim(s) }
    s
}

fn sanitize_title(title: Str) -> Str {
    title.replace("\n", " ").replace("\r", " ").replace("\t", " ")
}

pub fn format_task_line(id: Str, title: Str, priority: Int, status: Str, tags: Str, is_blocked: Bool) -> Str {
    let sid = short_id(id)
    let pstr = format_priority(priority)
    let sstr = format_status(status, is_blocked)
    let clean = sanitize_title(title)
    let display_title = if clean.len() > 72 { "{clean.slice(0, 72)}..." } else { clean }
    let color = use_color()
    let mut tag_part = ""
    if !tags.is_empty() {
        if color {
            tag_part = " [{term.magenta(tags)}]"
        } else {
            tag_part = " [{tags}]"
        }
    }
    let mut display_id = sid
    if color { display_id = term.cyan(sid) }
    "{sstr} {display_id}  {pstr}  {display_title}{tag_part}"
}

pub fn format_task_detail(id: Str, title: Str, description: Str, status: Str, priority: Int, created_at: Str, updated_at: Str, closed_at: Str, tags: Str, project: Str, blocks: Str, depends_on: Str, is_blocked: Bool) -> Str {
    let mut lines: List[Str] = []
    let color = use_color()
    let sid = short_id(id)
    let mut display_sid = sid
    if color { display_sid = term.cyan(sid) }
    lines.push("Task: {display_sid}")
    lines.push("  Full ID:  {id}")
    lines.push("  Title:    {sanitize_title(title)}")
    let mut status_line = status
    if status == "open" || status == "in_progress" {
        if is_blocked {
            status_line = "{status} (blocked)"
        } else {
            status_line = "{status} (ready)"
        }
    }
    lines.push("  Status:   {status_line}")
    lines.push("  Priority: {format_priority(priority)}")
    lines.push("  Desc:     {description}")
    let mut display_tags = tags
    if color && !tags.is_empty() { display_tags = term.magenta(tags) }
    lines.push("  Tags:     {display_tags}")
    lines.push("  Project:  {project}")
    lines.push("  Depends on: {depends_on}")
    lines.push("  Blocks:   {blocks}")
    lines.push("  Created:  {created_at}")
    lines.push("  Updated:  {updated_at}")
    if !closed_at.is_empty() {
        lines.push("  Closed:   {closed_at}")
    }
    lines.join("\n")
}

pub fn format_activity_line(action: Str, session_id: Str, project_path: Str, created_at: Str) -> Str {
    let mut parts: List[Str] = ["  {created_at}  {action}"]
    if !project_path.is_empty() {
        parts.push("  path={project_path}")
    }
    if !session_id.is_empty() {
        parts.push("  session={session_id}")
    }
    parts.join("")
}

pub fn format_note_line(content: Str, source: Str, session_id: Str, created_at: Str) -> Str {
    let mut header = "    [{source}] {created_at}"
    if !session_id.is_empty() {
        header = "{header}  session={session_id}"
    }
    "{header}\n      {content}"
}

pub fn format_project_line(id: Str, name: Str, status: Str, done: Int, total: Int) -> Str {
    let sid = short_id(id)
    let color = use_color()
    let mut display_id = sid
    if color { display_id = term.cyan(sid) }
    let mut display_status = status
    if color {
        if status == "active" { display_status = term.yellow(status) }
        else if status == "done" { display_status = term.green(status) }
        else { display_status = term.dim(status) }
    }
    "{display_id}  {name}  ({done}/{total})  {display_status}"
}
