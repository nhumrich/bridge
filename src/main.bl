import std.args.{ArgParser, Args, argparser_new, set_version, add_flag, add_command, command_add_positional, command_add_option, command_add_flag, argparse, args_error, args_command, args_has, args_get, args_get_all, args_positional, args_positional_count, generate_help, generate_command_help}
import std.db
import db.{db_path, init_db}
import argcheck.{try_validate_positional_count}
import commands.{cmd_add, cmd_ls, cmd_ready, cmd_show, cmd_note, cmd_edit, cmd_vi, cmd_transition_batch, cmd_rm_batch, cmd_dep_add, cmd_dep_rm, cmd_blocked, cmd_tag, cmd_untag, cmd_tags, cmd_stats, cmd_install, cmd_uninstall, cmd_graph, cmd_project_add, cmd_project_ls, cmd_project_show, cmd_project_edit, cmd_project_rm, cmd_project_tag, cmd_project_untag}

fn args_positionals_from(a: Args, start: Int) -> List[Str] {
    let mut result: List[Str] = []
    let mut i = start
    while i < args_positional_count(a) {
        result.push(args_positional(a, i))
        i = i + 1
    }
    result
}

fn parse_priority(s: Str) -> Int {
    let mut val = s.to_lower()
    if val.starts_with("p") { val = val.slice(1, val.len()) }
    let n = val.to_int()
    if n == 0 && val != "0" {
        io.eprintln("Invalid priority: {s}")
        exit(1)
    }
    if n < 0 || n > 4 {
        io.eprintln("Invalid priority: {s} (must be P0-P4)")
        exit(1)
    }
    n
}

fn build_parser() -> ArgParser {
    let mut p = argparser_new("br", "Bridge Task Manager")
    p = set_version(p, "0.12.0")

    p = add_flag(p, "--json", "-j", "JSON output")

    p = add_command(p, "add", "Add a new task")
    p = command_add_positional(p, "add", "title", "Task title")
    p = command_add_option(p, "add", "-p", "", "Priority (0=highest)")
    p = command_add_option(p, "add", "-t", "", "Tag (repeatable)")
    p = command_add_option(p, "add", "-d", "", "Description")
    p = command_add_option(p, "add", "--project", "", "Project name or ID")
    p = command_add_option(p, "add", "--session", "", "Session ID")

    p = add_command(p, "ls", "List tasks")
    p = command_add_option(p, "ls", "-s", "", "Filter by status")
    p = command_add_option(p, "ls", "-t", "", "Filter by tag")
    p = command_add_option(p, "ls", "--project", "", "Filter by project")
    p = command_add_flag(p, "ls", "--closed", "-c", "Show closed tasks")
    p = command_add_flag(p, "ls", "--all", "-a", "Show all tasks")

    p = add_command(p, "list", "List tasks")
    p = command_add_option(p, "list", "-s", "", "Filter by status")
    p = command_add_option(p, "list", "-t", "", "Filter by tag")
    p = command_add_option(p, "list", "--project", "", "Filter by project")
    p = command_add_flag(p, "list", "--closed", "-c", "Show closed tasks")
    p = command_add_flag(p, "list", "--all", "-a", "Show all tasks")

    p = add_command(p, "ready", "Show ready (unblocked) tasks")
    p = command_add_option(p, "ready", "-t", "", "Filter by tag")
    p = command_add_option(p, "ready", "--project", "", "Filter by project")

    p = add_command(p, "show", "Show task details")
    p = command_add_positional(p, "show", "id", "Task ID prefix")

    p = add_command(p, "note", "Add a note to a task")
    p = command_add_positional(p, "note", "id", "Task ID prefix")
    p = command_add_positional(p, "note", "content", "Note content")

    p = add_command(p, "edit", "Edit a task")
    p = command_add_positional(p, "edit", "id", "Task ID prefix")
    p = command_add_option(p, "edit", "--title", "", "New title")
    p = command_add_option(p, "edit", "--desc", "", "New description")
    p = command_add_option(p, "edit", "-p", "", "New priority")
    p = command_add_option(p, "edit", "-s", "", "New status")
    p = command_add_option(p, "edit", "--project", "", "Assign to project")
    p = command_add_flag(p, "edit", "--no-project", "", "Remove from project")
    p = command_add_option(p, "edit", "--append", "", "Append to description")

    p = add_command(p, "start", "Start a task")
    p = command_add_positional(p, "start", "id", "Task ID prefix (repeatable)")
    p = command_add_option(p, "start", "--session", "", "Session ID")

    p = add_command(p, "done", "Complete a task")
    p = command_add_positional(p, "done", "id", "Task ID prefix (repeatable)")
    p = command_add_option(p, "done", "--session", "", "Session ID")

    p = add_command(p, "close", "Complete a task")
    p = command_add_positional(p, "close", "id", "Task ID prefix (repeatable)")
    p = command_add_option(p, "close", "--session", "", "Session ID")

    p = add_command(p, "stop", "Stop working on a task (back to open)")
    p = command_add_positional(p, "stop", "id", "Task ID prefix (repeatable)")
    p = command_add_option(p, "stop", "--session", "", "Session ID")

    p = add_command(p, "cancel", "Cancel a task")
    p = command_add_positional(p, "cancel", "id", "Task ID prefix (repeatable)")
    p = command_add_option(p, "cancel", "--session", "", "Session ID")

    p = add_command(p, "reopen", "Reopen a closed task")
    p = command_add_positional(p, "reopen", "id", "Task ID prefix (repeatable)")
    p = command_add_option(p, "reopen", "--session", "", "Session ID")

    p = add_command(p, "rm", "Delete a task")
    p = command_add_positional(p, "rm", "id", "Task ID prefix (repeatable)")

    p = add_command(p, "dep", "Manage dependencies")
    p = add_command(p, "dep.add", "Add dependency")
    p = command_add_positional(p, "dep.add", "blocker", "Blocker task ID")
    p = command_add_positional(p, "dep.add", "blocked", "Blocked task ID")
    p = add_command(p, "dep.rm", "Remove dependency")
    p = command_add_positional(p, "dep.rm", "blocker", "Blocker task ID")
    p = command_add_positional(p, "dep.rm", "blocked", "Blocked task ID")

    p = add_command(p, "blocked", "Show blocked tasks")
    p = command_add_option(p, "blocked", "-t", "", "Filter by tag")
    p = command_add_option(p, "blocked", "--project", "", "Filter by project")

    p = add_command(p, "tag", "Add tags to task")
    p = command_add_positional(p, "tag", "id", "Task ID prefix")

    p = add_command(p, "untag", "Remove tags from task")
    p = command_add_positional(p, "untag", "id", "Task ID prefix")

    p = add_command(p, "tags", "List all tags")
    p = add_command(p, "stats", "Show task statistics")
    p = command_add_option(p, "stats", "-t", "", "Filter by tag")
    p = command_add_option(p, "stats", "--project", "", "Filter by project")

    p = add_command(p, "project", "Manage projects")
    p = add_command(p, "project.add", "Create a project")
    p = command_add_positional(p, "project.add", "name", "Project name")
    p = command_add_option(p, "project.add", "-d", "", "Description")
    p = command_add_option(p, "project.add", "-t", "", "Tag (repeatable)")
    p = add_command(p, "project.ls", "List projects")
    p = command_add_option(p, "project.ls", "-t", "", "Filter by tag")
    p = add_command(p, "project.show", "Show project details")
    p = command_add_positional(p, "project.show", "ref", "Project name or ID prefix")
    p = add_command(p, "project.edit", "Edit a project")
    p = command_add_positional(p, "project.edit", "ref", "Project name or ID prefix")
    p = command_add_option(p, "project.edit", "--name", "", "New name")
    p = command_add_option(p, "project.edit", "--desc", "", "New description")
    p = command_add_option(p, "project.edit", "-s", "", "New status (active/done/archived)")
    p = add_command(p, "project.rm", "Delete a project")
    p = command_add_positional(p, "project.rm", "ref", "Project name or ID prefix")
    p = add_command(p, "project.tag", "Add tags to a project")
    p = command_add_positional(p, "project.tag", "ref", "Project name or ID prefix")
    p = add_command(p, "project.untag", "Remove tags from a project")
    p = command_add_positional(p, "project.untag", "ref", "Project name or ID prefix")
    p = add_command(p, "graph", "Show dependency graph")
    p = command_add_positional(p, "graph", "id", "Task ID prefix (optional)")
    p = command_add_option(p, "graph", "-t", "", "Filter by tag")
    p = command_add_option(p, "graph", "--project", "", "Filter by project")
    p = command_add_flag(p, "graph", "--all", "-a", "Include done/cancelled tasks")

    p = add_command(p, "vi", "Edit task in $EDITOR")
    p = command_add_positional(p, "vi", "id", "Task ID prefix")

    p = add_command(p, "install", "Install Claude Code commands")
    p = add_command(p, "uninstall", "Remove Claude Code commands")
    p
}

fn run() {
    init_db()

    let p = build_parser()
    let a = argparse(p)
    let err = args_error(a)
    if err == "help" || err == "version" { exit(0) }
    if err != "" {
        io.eprintln(err)
        exit(1)
    }

    let cmd = args_command(a)
    let json_mode = args_has(a, "json")

    if cmd == "" {
        io.println(generate_help(p))
        exit(0)
    }

    let count_check = try_validate_positional_count(cmd, args_positional_count(a))
    if count_check.is_err() {
        io.eprintln(count_check.unwrap_err())
        exit(1)
    }

    let session_id = args_get(a, "session")

    if cmd == "add" {
        let title = args_positional(a, 0)
        if title == "" {
            io.eprintln("Usage: br add <title> [-p N] [-t tag] [-d desc]")
            exit(1)
        }
        let priority_str = args_get(a, "p")
        let priority_explicit = !priority_str.is_empty()
        let mut priority = 2
        if priority_explicit { priority = parse_priority(priority_str) }
        let description = args_get(a, "d")
        let tags = args_get_all(a, "t")
        let project_ref = args_get(a, "project")
        cmd_add(title, description, priority, priority_explicit, tags, project_ref, session_id)
    } else if cmd == "ls" || cmd == "list" {
        let status_filter = args_get(a, "s")
        let tag_filters = args_get_all(a, "t")
        let project_ref = args_get(a, "project")
        let show_closed = args_has(a, "closed")
        let show_all = args_has(a, "all")
        cmd_ls(status_filter, tag_filters, project_ref, json_mode, show_closed, show_all)
    } else if cmd == "ready" {
        let tag_filters = args_get_all(a, "t")
        let project_ref = args_get(a, "project")
        cmd_ready(tag_filters, project_ref, json_mode)
    } else if cmd == "show" {
        let id = args_positional(a, 0)
        if id == "" {
            io.eprintln("Usage: br show <id>")
            exit(1)
        }
        cmd_show(id, json_mode)
    } else if cmd == "note" {
        let id = args_positional(a, 0)
        let content = args_positional(a, 1)
        if id == "" || content == "" {
            io.eprintln("Usage: br note <id> \"note text\"")
            exit(1)
        }
        cmd_note(id, content)
    } else if cmd == "edit" {
        let id = args_positional(a, 0)
        if id == "" {
            io.eprintln("Usage: br edit <id> [--title T] [--desc D] [-p N] [-s status]")
            exit(1)
        }
        let title = args_get(a, "title")
        let append_val = args_get(a, "append")
        let mut description = args_get(a, "desc")
        let mut append = false
        if !append_val.is_empty() {
            description = append_val
            append = true
        }
        let priority_str = args_get(a, "p")
        let mut priority = -1
        if !priority_str.is_empty() { priority = parse_priority(priority_str) }
        let status = args_get(a, "s")
        let project_ref = args_get(a, "project")
        let clear_project = args_has(a, "no-project")
        cmd_edit(id, title, description, priority, status, project_ref, clear_project, append)
    } else if cmd == "start" {
        let ids = args_positionals_from(a, 0)
        if ids.is_empty() {
            io.eprintln("Usage: br start <id> [id...]")
            exit(1)
        }
        cmd_transition_batch(ids, "in_progress", "started", session_id)
    } else if cmd == "stop" {
        let ids = args_positionals_from(a, 0)
        if ids.is_empty() {
            io.eprintln("Usage: br stop <id> [id...]")
            exit(1)
        }
        cmd_transition_batch(ids, "open", "stopped", session_id)
    } else if cmd == "done" || cmd == "close" {
        let ids = args_positionals_from(a, 0)
        if ids.is_empty() {
            io.eprintln("Usage: br done <id> [id...]")
            exit(1)
        }
        cmd_transition_batch(ids, "done", "closed", session_id)
    } else if cmd == "cancel" {
        let ids = args_positionals_from(a, 0)
        if ids.is_empty() {
            io.eprintln("Usage: br cancel <id> [id...]")
            exit(1)
        }
        cmd_transition_batch(ids, "cancelled", "cancelled", session_id)
    } else if cmd == "reopen" {
        let ids = args_positionals_from(a, 0)
        if ids.is_empty() {
            io.eprintln("Usage: br reopen <id> [id...]")
            exit(1)
        }
        cmd_transition_batch(ids, "open", "reopened", session_id)
    } else if cmd == "rm" {
        let ids = args_positionals_from(a, 0)
        if ids.is_empty() {
            io.eprintln("Usage: br rm <id> [id...]")
            exit(1)
        }
        cmd_rm_batch(ids)
    } else if cmd == "dep add" {
        let (blocker, blocked) = (args_positional(a, 0), args_positional(a, 1))
        if blocker == "" || blocked == "" {
            io.eprintln("Usage: br dep add <blocker> <blocked>")
            exit(1)
        }
        cmd_dep_add(blocker, blocked)
    } else if cmd == "dep rm" {
        let (blocker, blocked) = (args_positional(a, 0), args_positional(a, 1))
        if blocker == "" || blocked == "" {
            io.eprintln("Usage: br dep rm <blocker> <blocked>")
            exit(1)
        }
        cmd_dep_rm(blocker, blocked)
    } else if cmd == "dep" {
        io.println(generate_command_help(p, "dep"))
    } else if cmd == "blocked" {
        let tag_filters = args_get_all(a, "t")
        let project_ref = args_get(a, "project")
        cmd_blocked(tag_filters, project_ref, json_mode)
    } else if cmd == "tag" {
        let id = args_positional(a, 0)
        let tags = args_positionals_from(a, 1)
        if id == "" || tags.is_empty() {
            io.eprintln("Usage: br tag <id> <tag> [tag...]")
            exit(1)
        }
        cmd_tag(id, tags)
    } else if cmd == "untag" {
        let id = args_positional(a, 0)
        let tags = args_positionals_from(a, 1)
        if id == "" || tags.is_empty() {
            io.eprintln("Usage: br untag <id> <tag> [tag...]")
            exit(1)
        }
        cmd_untag(id, tags)
    } else if cmd == "tags" {
        cmd_tags()
    } else if cmd == "stats" {
        let tag_filters = args_get_all(a, "t")
        let project_ref = args_get(a, "project")
        cmd_stats(tag_filters, project_ref)
    } else if cmd == "project add" {
        let name = args_positional(a, 0)
        if name == "" {
            io.eprintln("Usage: br project add <name> [-d desc] [-t tag]")
            exit(1)
        }
        let description = args_get(a, "d")
        let tags = args_get_all(a, "t")
        cmd_project_add(name, description, tags)
    } else if cmd == "project ls" {
        let tag_filters = args_get_all(a, "t")
        cmd_project_ls(json_mode, tag_filters)
    } else if cmd == "project show" {
        let ref = args_positional(a, 0)
        if ref == "" {
            io.eprintln("Usage: br project show <ref>")
            exit(1)
        }
        cmd_project_show(ref, json_mode)
    } else if cmd == "project edit" {
        let ref = args_positional(a, 0)
        if ref == "" {
            io.eprintln("Usage: br project edit <ref> [--name N] [--desc D] [-s status]")
            exit(1)
        }
        let name = args_get(a, "name")
        let description = args_get(a, "desc")
        let status = args_get(a, "s")
        cmd_project_edit(ref, name, description, status)
    } else if cmd == "project rm" {
        let ref = args_positional(a, 0)
        if ref == "" {
            io.eprintln("Usage: br project rm <ref>")
            exit(1)
        }
        cmd_project_rm(ref)
    } else if cmd == "project tag" {
        let ref = args_positional(a, 0)
        let tags = args_positionals_from(a, 1)
        if ref == "" || tags.is_empty() {
            io.eprintln("Usage: br project tag <ref> <tag> [tag...]")
            exit(1)
        }
        cmd_project_tag(ref, tags)
    } else if cmd == "project untag" {
        let ref = args_positional(a, 0)
        let tags = args_positionals_from(a, 1)
        if ref == "" || tags.is_empty() {
            io.eprintln("Usage: br project untag <ref> <tag> [tag...]")
            exit(1)
        }
        cmd_project_untag(ref, tags)
    } else if cmd == "project" {
        io.println(generate_command_help(p, "project"))
    } else if cmd == "graph" {
        let id = args_positional(a, 0)
        let tag_filters = args_get_all(a, "t")
        let show_all = args_has(a, "all")
        let project_ref = args_get(a, "project")
        cmd_graph(id, tag_filters, show_all, project_ref)
    } else if cmd == "vi" {
        let id = args_positional(a, 0)
        if id == "" {
            io.eprintln("Usage: br vi <id>")
            exit(1)
        }
        cmd_vi(id)
    } else if cmd == "install" {
        cmd_install()
    } else if cmd == "uninstall" {
        cmd_uninstall()
    } else {
        io.eprintln("Unknown command: {cmd}")
        io.eprintln("Run 'br --help' for usage")
        exit(1)
    }
}

fn main() {
    let path = db_path()
    with db.connect(path) {
        run()
    }
}
