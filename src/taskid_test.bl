import taskid.{id_from_hex, id_from_seed, generate_id, is_valid_id, display_id, strip_id_prefix, CROCKFORD}

test "id_from_hex returns 6 chars" {
    let id = id_from_hex("00112233445f")
    assert_eq(id.len(), 6)
}

test "id_from_hex is deterministic" {
    let a = id_from_hex("00112233445f")
    let b = id_from_hex("00112233445f")
    assert_eq(a, b)
}

test "id_from_hex output has no visually ambiguous chars" {
    let id = id_from_hex("00112233445f")
    assert(!id.contains("i"))
    assert(!id.contains("l"))
    assert(!id.contains("o"))
    assert(!id.contains("u"))
}

test "id_from_hex distinct inputs produce distinct ids" {
    let a = id_from_hex("00112233445f")
    let b = id_from_hex("ffeeddccbbaa")
    assert(a != b)
}

test "id_from_hex all-zero bytes maps to all-zero chars" {
    let id = id_from_hex("000000000000")
    assert_eq(id, "000000")
}

test "id_from_seed returns 6 valid crockford chars" {
    let id = id_from_seed(123456789)
    assert_eq(id.len(), 6)
    let mut i = 0
    while i < id.len() {
        let c = id.substring(i, i + 1)
        assert(CROCKFORD.contains(c))
        i = i + 1
    }
}

test "is_valid_id accepts a real generated id" {
    let id = generate_id(0)
    assert(is_valid_id(id))
}

test "is_valid_id rejects empty string" {
    assert(!is_valid_id(""))
}

test "is_valid_id rejects 5-char string" {
    assert(!is_valid_id("abcde"))
}

test "is_valid_id rejects a string containing u" {
    assert(!is_valid_id("abcduf"))
}

test "display_id adds the br- prefix" {
    assert_eq(display_id("abc123"), "br-abc123")
}

test "strip_id_prefix removes a leading br-" {
    assert_eq(strip_id_prefix("br-abc123"), "abc123")
}

test "strip_id_prefix ignores case" {
    assert_eq(strip_id_prefix("BR-ABC"), "ABC")
    assert_eq(strip_id_prefix("Br-abc"), "abc")
}

test "strip_id_prefix keeps a bare id" {
    assert_eq(strip_id_prefix("abc123"), "abc123")
}

test "strip_id_prefix keeps a bare id that starts with br" {
    assert_eq(strip_id_prefix("brd261"), "brd261")
}

test "strip_id_prefix of the bare prefix gives empty" {
    assert_eq(strip_id_prefix("br-"), "")
}

test "strip_id_prefix strips only one prefix" {
    assert_eq(strip_id_prefix("br-br-abc"), "br-abc")
}

test "strip_id_prefix of empty string is empty" {
    assert_eq(strip_id_prefix(""), "")
}
